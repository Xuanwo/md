{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@md/core": ["./src/md/core/index.ts"],
      "@md/core/*": ["./src/md/core/*"],
      "@md/shared": ["./src/md/shared/index.ts"],
      "@md/shared/*": ["./src/md/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "components.d.ts",
    "auto-imports.d.ts"
  ]
}
